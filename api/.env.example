# Supabase Configuration
# Server-side service role key (For database administration, server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
# Supabase Anon / Publishable Key (Backend only, used for per-request isolated auth client)
SUPABASE_ANON_KEY=eyJh...

# Supabase Database Schema (Default: slipsum)
SUPABASE_DB_SCHEMA=slipsum

# Auth Configuration
# Set to 'false' to automatically confirm email upon registration and login immediately
AUTH_REQUIRE_EMAIL_CONFIRM=false
# Frontend URL for redirecting password reset links
FRONTEND_URL=http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# CORS Settings (comma-separated allowed origins, e.g. http://localhost:3000,https://myapp.com or *)
CORS_ORIGINS=*

# Server Port
PORT=3000
