{
  "name": "snapbook-api",
  "version": "1.0.0",
  "description": "Production-ready REST API for tracking income/expenses by reading Thai bank slips",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@supabase/supabase-js": "^2.42.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "bignumber.js": "^9.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "1.4.5-lts.1",
    "pg": "^8.16.5",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.3",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/pg": "^8.11.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
